{
    "compilerOptions": {
        "allowJs": true,
        "lib": [
            "esnext",
            "dom"
        ],
        "strict": true,
        "target": "es2020",
        "module": "esnext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "@supabase/supabase-js/deno"
        ]
    }
}